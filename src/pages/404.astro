---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../consts';
---

<Layout title="ページが見つかりません — Hiroto Portfolio" noindex>
  <section class="not-found wrap">
    <p class="eyebrow">404 / NOT FOUND</p>
    <h1>道を、少し戻りましょう。</h1>
    <p>お探しのページは見つかりませんでした。</p>
    <a class="button button-dark" href={withBase()}>
      トップページに戻る
    </a>
  </section>
</Layout>
