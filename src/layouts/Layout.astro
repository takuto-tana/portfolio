---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <a href="#main" class="skip-link">
      本文へスキップ
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
