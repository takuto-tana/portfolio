---
import { profile } from '../data/profile';
import { withBase } from '../consts';
import Icon from './Icon.astro';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div>
        <p class="eyebrow">KEEP LEARNING. KEEP BUILDING.</p>
        <h2>コードと、その先の話を。</h2>
        <p>制作したコードや、日々の学びはこちらから。</p>
      </div>
      <div class="footer-links">
        <a href={profile.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" />
          GitHub<span class="sr-only">（新しいタブ）</span>
        </a>
        <a href={profile.qiita} target="_blank" rel="noopener noreferrer">
          <Icon name="book" />
          Qiita<span class="sr-only">（新しいタブ）</span>
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <a href={withBase()} class="footer-name">
        {profile.name}
        <span>.</span>
      </a>
      <span>
        © {new Date().getFullYear()} {profile.name}
      </span>
      <a href={withBase('making-of/')}>このサイトの制作について</a>
    </div>
  </div>
</footer>
