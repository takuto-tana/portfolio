---
interface Props {
  name: 'github' | 'book' | 'code' | 'spark' | 'check' | 'external';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'github' && (
    <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M15 22v-3.4c0-1 .1-1.7-.5-2.3 3.1-.3 6.4-1.5 6.4-7A5.4 5.4 0 0 0 19.5 5c.1-.4.6-2-.2-4 0 0-1.2-.4-4 1.5a13.5 13.5 0 0 0-7 0C5.5.6 4.3 1 4.3 1c-.8 2-.3 3.6-.2 4A5.4 5.4 0 0 0 2.7 9c0 5.5 3.3 6.7 6.4 7-.4.5-.6 1.1-.6 2.3V22" />
  )}
  {name === 'book' && (
    <>
      <path d="M12 5v16M3 3c4-1 7 0 9 2 2-2 5-3 9-2v15c-4-1-7 0-9 2-2-2-5-3-9-2Z" />
    </>
  )}
  {name === 'code' && (
    <>
      <path d="m7 7-5 5 5 5m10-10 5 5-5 5m-4-14-2 18" />
    </>
  )}
  {name === 'spark' && <path d="m12 2 2.7 7.3L22 12l-7.3 2.7L12 22l-2.7-7.3L2 12l7.3-2.7Z" />}
  {name === 'check' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m8 12 3 3 5-6" />
    </>
  )}
  {name === 'external' && (
    <>
      <rect x="3" y="7" width="14" height="14" rx="3" />
      <path d="M9 3h12v12M9 3v4m8 8h4" />
    </>
  )}
</svg>
